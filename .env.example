# ---------------------------------------------------------------------------
# Build-time (Astro) — these are PUBLIC. They end up in the built HTML.
# Set them in Cloudflare Pages → Settings → Environment variables (Production).
# ---------------------------------------------------------------------------

# The client's WhatsApp Business number, full international format.
# Digits only: no "+", no spaces, no dashes, NO LEADING ZERO.
#   +27 82 123 4567  ->  27821234567
#   0803 456 7890    ->  234803456789 0  (drop the 0, prepend country code)
# Leave unset to keep the build in PLACEHOLDER MODE (see src/config/site.ts).
PUBLIC_WA_NUMBER=

# ---------------------------------------------------------------------------
# Runtime (Pages Function) — these are SECRET. Never prefix them PUBLIC_.
# Set as encrypted secrets in Cloudflare Pages → Settings → Environment variables.
# For local `wrangler pages dev`, copy these into a .dev.vars file (gitignored).
# ---------------------------------------------------------------------------

# The Apps Script web app URL (ends in /exec) that writes to the Google Sheet.
SHEET_WEBHOOK_URL=

# Shared secret. Must match the SECRET script property in the Apps Script project.
# Generate with: openssl rand -hex 24
SHEET_SECRET=
