---
import { SITE } from '../config/site';
import { CATEGORIES } from '../data/catalog';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    {/*
      Same file as the header, deliberately — the browser fetches
      logo-horizontal.webp once and serves both from cache.

      The lockup already carries the brand name AND the descriptor, so the heading
      and tagline that used to sit here would repeat both within a few pixels of
      the image — and would print "jewelry" directly beneath the lockup's
      "JEWELRY". The image replaces them rather than joining them.

      Deliberately not a link: the header wordmark already goes home, and a
      second control to the same place is a tab stop that leads nowhere new.
      width/height are intrinsic, so the footer can't reflow as it loads.
    */}
    <div class="site-footer__brand">
      <img
        class="site-footer__logo"
        src="/brand/logo-horizontal.webp"
        alt={SITE.brand}
        width="1200"
        height="289"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div>
      <h2>Shop</h2>
      <ul>
        {CATEGORIES.map((c) => <li><a href={`/shop/?c=${c.id}`}>{c.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href="/contact/">Message us</a></li>
        <li><a href="/gifts/">Gifts</a></li>
        <li><a href="/guide/">Care &amp; sizing</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li>{SITE.hours}</li>
      </ul>
    </div>

    {/*
      Separators are written as {' · '} rather than a bare "·" at the end of a
      line: Astro strips the leading whitespace from continuation lines, which
      previously rendered "reserved. ·Privacy" with no space after the bullet.
      An explicit expression is immune to that collapsing.
    */}
    <div class="site-footer__legal">
      <span>
        © {year} {SITE.brand}. All rights reserved.
        {' · '}<a href="/privacy/">Privacy</a>
      </span>
      {/*
        Build credit. The only outbound link on the site, so it carries the same
        rel as the WhatsApp CTAs — noopener stops the opened tab reaching back
        through window.opener, noreferrer withholds the referrer header.
      */}
      <span>Powered by{' '}
      <a
        class="site-footer__credit"
        href="https://insiibleconsulting.com/"
        target="_blank"
        rel="noopener noreferrer">Insiible Consulting</a></span>
    </div>
  </div>
</footer>
