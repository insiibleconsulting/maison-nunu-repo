---
import Base from '../layouts/Base.astro';
import MessagePreview from '../components/MessagePreview.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import ProductImage from '../components/ProductImage.astro';
import { SITE } from '../config/site';
import { featured, CATEGORIES, PRODUCTS, formatPrice } from '../data/catalog';
import { generalLink } from '../lib/whatsapp';
---

<Base>
  <!--
    The hero is the thesis. Every other jewelry site opens with a product
    photograph and a headline over it; this business runs on conversation, so
    the hero shows a conversation. It explains the entire model at a glance and
    sets the expectation for what the buttons do.
  -->
  <section class="hero">
    <div class="shell hero__inner">
      <div class="hero__copy">
        <span class="eyebrow">{SITE.tagline}</span>
        <h1>Ask us about the one you like.</h1>
        <p class="lede">
          A selection of jewelry and accessories, chosen piece by piece. There’s no checkout here,
          you message us about a piece, and we help you get the details right before anything ships.
        </p>
        <div class="hero__actions">
          <a class="btn btn--ghost" href="/shop/">Browse the collection</a>
          <WhatsAppCTA href={generalLink()} label="Message us" />
        </div>
      </div>

      <div class="hero__thread">
        <div class="hero__thread-head">
          <span class="hero__avatar" aria-hidden="true">M</span>
          <div>
            <div class="hero__thread-name">{SITE.brand}</div>
            <div class="hero__thread-status">Typically replies within the hour</div>
          </div>
        </div>

        <MessagePreview
          direction="out"
          message={"Hi Maison Nunu! I’m interested in the Noor Stone Ring.\n(ref: RNG-03)"}
        />
        <MessagePreview
          direction="in"
          message={'Lovely choice. That one we order in, so you get to pick the stone. Shall I send photos of what’s available?'}
        />
        <MessagePreview direction="out" message={'Yes please. Do you have anything more blue?'} />
      </div>
    </div>
  </section>

  {/*
    One section where there were two.

    "This season" showed one featured piece per collection. "Find your thing"
    showed one photograph per collection. Both were four-column grids of equal
    tiles, stacked on each other, and between them plus the collections bar and
    the footer the same eight collections were listed on this page four times.
    Two grids doing one job is also exactly the shape a stock theme ships.

    Merged, the block finally states the thing the shop actually claims: a short
    selection, and a piece someone chose from each part of it. The photograph
    goes to that piece, the name goes to the collection - two destinations, both
    real, rather than one repeated.
  */}
  <section class="section">
    <div class="shell">
      <h2>Eight collections, one pick from each.</h2>

      <div class="picks">
        {CATEGORIES.map((c) => {
          const pick = featured().find((p) => p.category === c.id)
            ?? PRODUCTS.find((p) => p.category === c.id && p.image);
          const count = PRODUCTS.filter((p) => p.category === c.id).length;
          if (!pick) return null;
          return (
            <div class="pick">
              <a class="pick__frame" href={`/shop/${pick.slug}/`}>
                <ProductImage
                  image={pick.image}
                  name={pick.name}
                  sku={pick.sku}
                  category={c.id}
                />
              </a>
              <div class="pick__text">
                <div class="pick__row">
                  <a class="pick__collection" href={`/shop/?c=${c.id}`}>{c.label}</a>
                  <span class="pick__count">{count} pieces</span>
                </div>
                <p class="pick__piece">
                  {pick.name}
                  <span class="pick__price">{formatPrice(pick.price)}</span>
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!--
    Numbered because this genuinely is a sequence — the order carries
    information the reader needs. Numbering anything else here would be
    decoration pretending to be structure.
  -->
  <section class="section">
    <div class="shell">
      <h2>No checkout, on purpose.</h2>
      <ol class="steps">
        <li class="reveal">
          <h3>Find a piece</h3>
          <p>Browse the collection. Every piece has its own enquiry button.</p>
        </li>
        <li class="reveal">
          <h3>Send the message</h3>
          <p>
            WhatsApp opens with the piece and its reference already written out. You just press send.
          </p>
        </li>
        <li class="reveal">
          <h3>We sort the details</h3>
          <p>
            Sizing, stones, delivery, what’s actually in stock. Most of what we sell needs one
            question answered first, and a cart can’t ask it.
          </p>
        </li>
      </ol>
    </div>
  </section>

  {/*
    `measure` sits INSIDE `shell` rather than beside it. Both set max-width, and
    `shell` also sets `margin-inline: auto` — so `class="shell measure"` narrows
    the box to 62ch and then centres that box in the viewport. On the text-only
    pages that reads as a deliberate reading column, but here it made this one
    section drift to the middle while the four above it start at the shell's
    left edge. Nesting keeps the measure and restores the alignment.
  */}
  <section class="section">
    <div class="shell">
      <div class="measure">
        <h2 style="margin-bottom:var(--s-3);">Chosen, not stocked.</h2>
        <p style="margin-bottom:var(--s-4);">
          We buy in small quantities from makers we rate, so the selection stays short enough that
          we know every piece on it. Ask us anything about one before you commit.
        </p>
        <WhatsAppCTA href={generalLink()} label="Message us" />
      </div>
    </div>
  </section>
</Base>
