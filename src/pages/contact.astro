---
/**
 * Tier 2 CTA — the micro-form.
 *
 * Everywhere else on the site uses a direct deep link, because friction costs
 * conversions. Here, on a page someone reached deliberately, we trade a little
 * friction for an actual contact record: a deep-link click tells us WHAT was
 * clicked but never WHO clicked it. This form is the only place we learn a name.
 */
import Base from '../layouts/Base.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { SITE, WA_NUMBER, IS_PLACEHOLDER_NUMBER } from '../config/site';
import { generalLink } from '../lib/whatsapp';
import { PRODUCTS, CATEGORIES } from '../data/catalog';
import MessagePreview from '../components/MessagePreview.astro';
---

<Base title="Contact" description={`Get in touch with ${SITE.brand} on WhatsApp.`}>
  <section class="section">
    <div class="shell measure">
      <span class="eyebrow">Contact</span>
      <h1 style="margin-top:0.5rem;">Tell us what you’re after.</h1>
      <p class="lede" style="margin-top:1rem; margin-bottom:2rem;">
        Fill this in and WhatsApp opens with your message ready to send. Or skip it and message us
        directly. Both reach the same place.
      </p>

      <form id="enquiry" data-wa-number={WA_NUMBER} novalidate>
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" required autocomplete="name" maxlength="80" />
        </div>

        <div class="field">
          <label for="piece">Which piece? <span class="optional">optional</span></label>
          {/*
            Grouped by collection. As one flat list this was 75 product names in
            a single native wheel, which asks the visitor to recall a name they
            saw once with no photograph and no order to scan by. The collection
            is already on every record, so the grouping costs nothing.
          */}
          <select id="piece" name="piece">
            <option value="">Not sure yet / something else</option>
            {CATEGORIES.map((c) => {
              const inGroup = PRODUCTS.filter((p) => p.category === c.id);
              return inGroup.length ? (
                <optgroup label={c.label}>
                  {inGroup.map((p) => (
                    <option value={p.sku} data-name={p.name}>{p.name}</option>
                  ))}
                </optgroup>
              ) : null;
            })}
          </select>
        </div>

        <div class="field">
          <label for="message">What would you like to know?</label>
          <textarea id="message" name="message" rows="4" maxlength="600"
            placeholder="Sizing, a stone, a gift, a deadline…"></textarea>
        </div>

        <!-- Honeypot: hidden from people, irresistible to naive bots. -->
        <div class="hp" aria-hidden="true">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {/*
          The preview, finally. This was the one handoff on the site that asked
          for more than any other - a name, a written question - and gave back
          less reassurance than a product page that asks for nothing. It renders
          server-side with the empty-form message, so it says something true
          with scripting off, and the script below rewrites it from the SAME
          function that builds the URL. If those two ever drift, the bubble
          stops being honest, which is the only thing it has.
        */}
        <div id="preview">
          <MessagePreview label="You’ll send" message="Hi Maison Nunu!" />
        </div>

        <button class="btn btn--wide" type="submit" disabled={IS_PLACEHOLDER_NUMBER}>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23z" />
          </svg>
          <span data-btn-text
            >{IS_PLACEHOLDER_NUMBER ? 'WhatsApp number not configured' : 'Continue to WhatsApp'}</span
          >
        </button>

        <p class="consent">
          We’ll use these details only to answer your enquiry. Nothing is shared with anyone else.
          Ask us and we’ll delete them.
        </p>
      </form>

      <div class="alt">
        <h2 class="subhead" style="margin-bottom:0.7rem;">Rather just message?</h2>
        <WhatsAppCTA href={generalLink()} label="Open WhatsApp" variant="ghost" />
      </div>

      <div class="alt">
        <h2 class="subhead" style="margin-bottom:0.7rem;">Other ways</h2>
        <p class="meta">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          {SITE.hours} · {SITE.location}
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.1rem;
  }

  label {
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }

  .optional {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    color: var(--faint);
  }

  input,
  select,
  textarea {
    font-family: var(--sans);
    font-size: 0.95rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line-interactive);
    border-radius: 2px;
    background: var(--surface-raised);
    color: var(--ink);
    width: 100%;
    /* 0.7rem padding on a 0.95rem line measured 40px. */
    min-height: 44px;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--burgundy);
    outline-offset: 1px;
    border-color: var(--burgundy);
  }

  input[aria-invalid='true'] {
    border-color: var(--error);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent {
    font-family: var(--sans);
    font-size: 0.76rem;
    color: var(--muted);
    margin-top: 0.8rem;
    line-height: 1.5;
  }

  .error {
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--error);
  }

  .alt {
    margin-top: 2.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
  }
</style>

<script>
  /*
   * ONE function builds the message. The preview bubble and the wa.me URL both
   * read from it, so what the visitor is shown is by construction the thing
   * that gets sent — which is the only property that makes the bubble worth
   * having. Do not inline this string at either call site again.
   */
  function buildMessage(): string {
    const nameEl = document.getElementById('name') as HTMLInputElement | null;
    const pieceEl = document.getElementById('piece') as HTMLSelectElement | null;
    const msgEl = document.getElementById('message') as HTMLTextAreaElement | null;

    const name = nameEl?.value.trim() ?? '';
    const opt = pieceEl?.selectedOptions[0];
    const sku = pieceEl?.value ?? '';
    const pieceName = sku ? (opt?.dataset.name ?? opt?.textContent?.trim() ?? '') : '';
    const message = msgEl?.value.trim() ?? '';

    /*
     * The ref goes on its own line at the end, matching productMessage(). It
     * used to sit mid-sentence, which read fine in WhatsApp but left the
     * preview bubble showing "the Aurelia Signet Ring ." once the ref was
     * lifted out for tinting. Same convention everywhere is also just easier
     * for whoever is reading these on a phone all day.
     */
    return [
      name ? `Hi Maison Nunu! I\u2019m ${name}.` : 'Hi Maison Nunu!',
      pieceName ? `I\u2019d like to know more about the ${pieceName}.` : '',
      message,
      sku ? `(ref: ${sku})` : '',
    ]
      .filter(Boolean)
      .join('\n');
  }

  /* Repaint the bubble from that same string. Mirrors MessagePreview's own
     split so the ref keeps its tint. */
  function paintPreview() {
    const wrap = document.getElementById('preview');
    if (!wrap) return;
    const body = wrap.querySelector<HTMLElement>('[data-msg-body]');
    const ref = wrap.querySelector<HTMLElement>('[data-msg-ref]');
    const br = wrap.querySelector<HTMLElement>('[data-msg-br]');
    if (!body || !ref || !br) return;

    const full = buildMessage();
    const m = full.match(/\(ref:\s*([^)]+)\)/);
    body.textContent = m ? full.replace(m[0], '').trimEnd() : full;
    ref.textContent = m ? `(ref: ${m[1]})` : '';
    ref.hidden = !m;
    br.hidden = !m;
  }

  for (const id of ['name', 'piece', 'message']) {
    document.getElementById(id)?.addEventListener('input', paintPreview);
  }
  paintPreview();

  const form = document.getElementById('enquiry') as HTMLFormElement | null;

  if (form) {
    const number = form.dataset.waNumber ?? '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const nameInput = form.querySelector<HTMLInputElement>('#name')!;
      const name = nameInput.value.trim();

      // Minimal validation — the only field we genuinely need.
      form.querySelector('.error')?.remove();
      if (!name) {
        nameInput.setAttribute('aria-invalid', 'true');
        const err = document.createElement('p');
        err.className = 'error';
        // role="alert" so the message is announced, not just drawn. Injected
        // markup is silent to a screen reader without it.
        err.setAttribute('role', 'alert');
        err.id = 'name-error';
        err.textContent = 'Please add your name so we know who we’re talking to.';
        nameInput.insertAdjacentElement('afterend', err);
        nameInput.setAttribute('aria-describedby', 'name-error');
        nameInput.focus();
        return;
      }
      nameInput.removeAttribute('aria-invalid');
      nameInput.removeAttribute('aria-describedby');

      // Silently drop bots rather than telling them they were caught.
      const honeypot = form.querySelector<HTMLInputElement>('#company')!;
      if (honeypot.value) return;

      const select = form.querySelector<HTMLSelectElement>('#piece')!;
      const sku = select.value;
      const pieceName = select.selectedOptions[0]?.dataset.name ?? '';
      const message = form.querySelector<HTMLTextAreaElement>('#message')!.value.trim();

      // Pending state: the request below can take up to 1.2s, and a button that
      // looks identical after being pressed invites a second press.
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const submitText = submit.querySelector<HTMLElement>('[data-btn-text]')!;
      const restore = submitText.textContent;
      submit.disabled = true;
      submitText.textContent = 'Opening WhatsApp…';

      // Log first — this is the one place we actually capture a name, so unlike
      // the deep-link CTAs it is worth a short await. Capped so a slow or dead
      // endpoint can never strand someone on this page.
      try {
        await Promise.race([
          fetch('/api/lead', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              sku: sku || 'ENQUIRY',
              label: pieceName || 'General enquiry',
              page: window.location.pathname,
              referrer: document.referrer,
              name,
              note: message,
            }),
          }),
          new Promise((resolve) => setTimeout(resolve, 1200)),
        ]);
      } catch {
        /* never block the handoff on telemetry */
      }

      // Restore on bfcache restore — otherwise someone who taps back from
      // WhatsApp finds a permanently disabled button.
      window.addEventListener('pageshow', () => {
        submit.disabled = false;
        submitText.textContent = restore;
      });

      // encodeURIComponent, not URLSearchParams — the latter encodes spaces
      // as "+", which WhatsApp renders literally.
      window.location.href = `https://wa.me/${number}?text=${encodeURIComponent(buildMessage())}`;
    });
  }
</script>
