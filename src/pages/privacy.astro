---
/**
 * Required because the contact form collects a name. Keep this honest and
 * specific — it is also the page the client will be asked about if anyone
 * queries their data handling.
 *
 * TODO before launch: confirm which regime applies (GDPR / POPIA / NDPR),
 * and fill in the registered business name and address.
 */
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
---

<Base title="Privacy" description="How Maison Nunu handles your information.">
  <section class="section">
    <div class="shell measure">
      <span class="eyebrow">Privacy</span>
      <h1 style="margin-top:0.5rem;">What we collect, and why.</h1>

      <h2 class="subhead" style="margin-top:2rem; margin-bottom:0.6rem;">When you browse</h2>
      <p style="margin-bottom:1rem;">
        We record which pieces get enquired about: the reference, the page, and the country the
        request came from. This is not linked to you personally and we do not use tracking cookies.
      </p>

      <h2 class="subhead" style="margin-top:2rem; margin-bottom:0.6rem;">When you use the enquiry form</h2>
      <p style="margin-bottom:1rem;">
        We store the name and message you give us, so we can answer you. It goes into a private
        spreadsheet only {SITE.brand} can see, and we email ourselves a copy so nothing gets missed.
      </p>

      <h2 class="subhead" style="margin-top:2rem; margin-bottom:0.6rem;">When you message us on WhatsApp</h2>
      <p style="margin-bottom:1rem;">
        Your conversation is between you and us inside WhatsApp, and is covered by WhatsApp’s own
        privacy terms. We see your phone number and whatever you choose to tell us.
      </p>

      <h2 class="subhead" style="margin-top:2rem; margin-bottom:0.6rem;">We don’t sell your details</h2>
      <p style="margin-bottom:1rem;">
        Not to anyone, ever. We don’t add you to a mailing list unless you ask.
      </p>

      <h2 class="subhead" style="margin-top:2rem; margin-bottom:0.6rem;">Removing your details</h2>
      <p style="margin-bottom:1rem;">
        Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or message us on WhatsApp and we’ll
        delete what we hold. No explanation needed.
      </p>

      <p class="meta" style="margin-top:2.4rem;">Last updated 31 July 2026.</p>
    </div>
  </section>
</Base>
